{
	"name": "wp-media-phpunit",
	"description": "Local WordPress test environment (wp-env) for the wp-media/phpunit package.",
	"private": true,
	"license": "GPL-2.0+",
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:install": "wp-env run tests-cli --env-cwd=wp-content/plugins/wpmedia-phpunit composer install",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/wpmedia-phpunit composer run-tests",
		"test:php:unit": "wp-env run tests-cli --env-cwd=wp-content/plugins/wpmedia-phpunit composer test-unit",
		"test:php:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/wpmedia-phpunit composer test-integration",
		"test:php:integration-admin": "wp-env run tests-cli --env-cwd=wp-content/plugins/wpmedia-phpunit composer test-integration-admin"
	},
	"devDependencies": {
		"@wordpress/env": "^10.0.0"
	}
}
